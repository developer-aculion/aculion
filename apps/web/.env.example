# ─────────────────────────────────────────────────────────────
#  Aculion Email Server — Environment Variables TEMPLATE
#  Copy this file to ".env" and fill in your credentials.
#  The ".env" file is gitignored and must NEVER be committed.
# ─────────────────────────────────────────────────────────────

# ── Option 1: Resend (RECOMMENDED — free tier: 100 emails/day) ──
# Sign up at https://resend.com → Dashboard → API Keys → Create
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: custom sender (requires verified domain)
# RESEND_FROM=Aculion Website <contact@aculion.com>

# ── Option 2: Gmail SMTP (fallback — requires App Password) ──
# Only used if RESEND_API_KEY is NOT set
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx

# ── Option 3: Custom SMTP provider ──
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-smtp-password

# ── General settings ──
RECIPIENT_EMAIL=connect@aculion.com
PORT=3001
FRONTEND_URL=http://localhost:5173
